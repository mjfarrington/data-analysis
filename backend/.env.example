# Data Analysis Platform — Environment Configuration
APP_NAME=Data Analysis Platform
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/metadata.db

# Spark endpoints
SPARK_MASTER_URL=spark://localhost:7077
SPARK_CONNECT_URL=sc://localhost:15002
SPARK_THRIFT_PORT=10000
SPARK_MASTER_WEBUI=http://localhost:8080
SPARK_WORKER_WEBUI=http://localhost:8081
SPARK_HISTORY_WEBUI=http://localhost:18080

# gRPC Data Extract Service
GRPC_HOST=localhost
GRPC_PORT=50051
GRPC_TIMEOUT=30.0
GRPC_MAX_MESSAGE_MB=64

# ETL
DEFAULT_PAGE_SIZE=10000
MAX_CONCURRENT_RUNS=5

# Connection secret key (Fernet) — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Do NOT commit the actual key. Set it in .env (which is gitignored).
CONNECTIONS_SECRET_KEY=
